::: obstaculos y recompensas
Esqueleto Obstaculo --> (&dano(ent)) { IGNOR; };

Esqueleto Recompensa --> (&valor(ent)) { IGNOR; };

Esqueleto Jugador --> (&vida(ent), &puntos(ent)) {
    MetaAccion Curar --> (&cantidad(ent)) {
        Accion Tope --> (&v(ent)) {
            (&v % 100).retornar;
        };
        @esto.&vida := Tope(@esto.&vida + &cantidad);
    };

    MetaAccion Sumar --> (&p(ent)) {
        @esto.&puntos := @esto.&puntos + &p;
        (@esto.&puntos).retornar;
    };

    MetaAccion Chocar --> (Obstaculo otro) {
        @esto.&vida := @esto.&vida - otro.&dano;
    };

    MetaAccion Reiniciar --> () {
        ev( (@esto.&vida =< 0) ? { ().retornar; } );
        @esto.&vida := 10;
    };
};

Esqueleto Mago --> ObtieneDe Jugador --> (&mana(ent)) {
    MetaAccion Descansar --> () { IGNOR; };
};