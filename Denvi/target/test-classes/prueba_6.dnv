Esqueleto Principal --> {

    ::: ============ PARTE VALIDA ============

    #iva(dec) := 0.16;
    &precio(ent) := 20;
    &cantidad(ent) := 3;
    &total(dec) := (&precio * &cantidad) * (1 + #iva);
    ImpConsSl("Total con IVA: " + &total);

    &contador(ent) := 99;
    &maximo(ent) := 2147483647;
    &pendiente(ent);
    &divisor(ent) := 0;

    Mundo &vidas(ent) := 3;
    
    ::*
    Accion Doble --> (&n(ent)) {
        (&n * 2).retornar;
    };

    Accion Bucle --> () {
        Bucle();
    };

    ev ((&precio > 50) ? {
        ImpConsSl("Precio alto");
    } -> alt {
        ImpConsSl("Precio bajo");
    });

    rep ((&i(ent) := 1) -> (&i =< 3) ? {
        ImpConsSl("Doble de " + &i + " = " + Doble(&i));
    } : ++);

    Nivel Entrada -> (
        ()
        {
            ImpConsSl("Estas en la entrada");
        }
    ) .Portal --> Salon;

    Nivel Salon -> (
        ()
        {
            ImpConsSl("Estas en el salon");
        }
    );

    Nivel Azotea -> (
        ()
        {
            IGNOR;
        }
    );

    Viajar(Entrada);
    Viajar(Salon);
    *::

    ::: ============ ERRORES ============

    ::: 1) Variable no declarada
    ::: &resultado(ent) := &precio + &descuento;

    ::: 2) Variable no inicializada (&pendiente se declaro sin valor)
    ::: ImpConsSl("Pendiente: " + &pendiente);

    ::: 3) Tipos incompatibles (asignar cadena a ent)
    ::: &edad(ent) := "veinte";

    ::: 4) Tipos incompatibles en operacion (resta con cadena)
    ImpConsSl(5 - "a");

    ::: 5) Division entre cero
    ImpConsSl("Resultado: " + (&precio / &divisor));

    ::: 6) Desbordamiento de entero (&maximo ya vale 2147483647)
    ::: &maximo := &maximo + 1;

    ::: 7) Literal fuera de rango
    ::: &enorme(ent) := 99999999999;

    ::: 8) Declaracion duplicada (&contador ya existe)
    ::: &contador(ent) := 5;

    ::: 9) Simbolo no encontrado (funcion inexistente)
    ::: Fantasma(3);

    ::: 10) Argumentos invalidos (Doble espera 1 y recibe 2)
    ::: ImpConsSl(Doble(1, 2));

    ::: 11) Retorno invalido (retornar fuera de una funcion)
    ::: (5).retornar;

    ::: 12) Desbordamiento de pila (recursion infinita)
    ::: Bucle();

    ::: 13) Clase no encontrada
    ::: Fantasma f := iniciar();

    ::: 14) Nivel invalido (el nivel no existe)
    ::: Viajar(Inexistente);

    ::: 15) Portal invalido (Salon no tiene portal hacia Azotea)
    ::: Viajar(Azotea);

};