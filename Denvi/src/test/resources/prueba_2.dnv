Import mundo.clase.dnv;
Import jugador.clase.dnv;

Esqueleto Principal --> {
    MetaAccion Bienvenida --> () {
        ImpConsSl("Bienvenido a DENVI");
    };

    MetaAccion Resumen --> (&texto(cad)) {
        ImpConsSl("Resumen: " -> &texto);
    };

    ::: ---- programa ----
    ::* Variables, constantes, tipos, arreglos y listas *::
    Mundo &meta(ent):=3;
    Mundo &meta:=3;
    #bonus(ent):=10;
    &total(ent):=0;
    &precio(dec):=9.99;
    &nombre(cad):="Denvi";
    &letra(car):='d';
    &activo(boo):=verdadero;
    &limite(tm):=[1:30];
    &vacio(nl):=nulo;
    ar &posiciones(ent):=[1, [2, 3]];
    lt &letras(car):={'a', 'b'};

    Accion Doble --> (&n(ent)) {
        (&n * 2).retornar;
    };

    Bienvenida();
    Resumen(&nombre);

    ::* Objetos y llamadas a metodos *::
    Jugador heroe := iniciar(10, 0);
    Mago brujo := iniciar(4);
    Obstaculo roca1 := iniciar(2);
    Recompensa moneda := iniciar(5);

    heroe.Chocar(roca1);
    heroe.Curar(5);
    heroe.Sumar(#bonus);
    heroe.Reiniciar();
    heroe.&vida := heroe.&vida + 1;
    heroe.&puntos := ++;

    ::* Ciclos y decision de tres caminos *::
    rep( (&i(ent):=1) -> (&i < 6) ? {
        &total := &total + &i;
        ev( (&i % 2 == 0) ? { ImpConsSl("par: " -> &i); }
            -> evalt (&i == 5) ? { ImpConsSl("cinco"); }
            -> alt { ImpConsSl("impar: " -> &i); } );
    } : ++ );

    rep( (&k(ent):=10) -> (&k > 0) ? { ImpCons(&k -> " "); } : -?(3) );

    &dobleTotal(ent):=Doble(&total);
    &total := +?(5);
    ImpConsSl("total: " -> &total -> " doble: " -> &dobleTotal);

    ::* Entrada de datos *::
    &edad(ent):=0;
    ObtDatos(ent:&edad);
    ev( (&edad => 18) ? { ImpConsSl("mayor de edad"); }
        -> alt { ImpConsSl("menor de edad"); } );

    ::* Escenarios, sucesos y portales *::
    Nivel Bosque -> (() {
        Situar(heroe -> (0, 0));
        Situar(roca1 -> (2, 3));
        Situar(moneda -> (3, 4));

        Suceso((heroe, Choque) -> {
            heroe.Chocar(roca1);
        });

        Suceso((heroe, Toma) -> {
            heroe.Sumar(#bonus);
            Retirar(moneda);
        });

        Suceso((heroe.&puntos => &meta) -> {
            ImpConsSl("meta alcanzada");
            Viajar(Cueva);
        });
    }).Portal --> (Cueva, Salida);

    Nivel Cueva -> ((&oscuro(boo):=verdadero) {
        ev( (&oscuro) ? { ImpConsSl("hace frio"); } -> alt { IGNOR; } );
        Suceso((heroe.&vida =< 0) -> { Viajar(Salida); });
    });

    Nivel Entorno -> (() {
        Zona Entrada -> (() { IGNOR; }),
        Zona Fondo -> ((&abierta(boo):=falso) { IGNOR; })
    });

    Nivel Salida -> (() { IGNOR; });

    Cueva.Portal --> Salida;
    Viajar(Bosque);
    ImpConsSl("fin");
};